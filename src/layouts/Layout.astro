---
import '../styles/global.css';
import '../styles/motion.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Motion from '../components/Motion.astro';
import { artists, site } from '../data/site';
interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}
const {
  title,
  description = 'Explora el cartel, las fotografías y la historia de Festival Dängo 2026. Música, arte y cultura en Rancho La Ventilla, Teotihuacán, México.',
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const isHome = Astro.url.pathname === '/';
const graph = [
  {
    '@type': 'Organization',
    '@id': `${site.url}/#organization`,
    name: site.name,
    url: site.url,
    logo: `${site.url}/favicon.svg`,
    sameAs: [site.instagram, 'https://www.tiktok.com/@festivaldango'],
  },
  {
    '@type': 'WebSite',
    '@id': `${site.url}/#website`,
    name: site.name,
    url: site.url,
    inLanguage: 'es-MX',
    publisher: { '@id': `${site.url}/#organization` },
  },
  {
    '@type': 'WebPage',
    '@id': canonical,
    url: canonical,
    name: title,
    description,
    inLanguage: 'es-MX',
    isPartOf: { '@id': `${site.url}/#website` },
  },
  ...(isHome
    ? [
        {
          '@type': 'MusicFestival',
          '@id': `${site.url}/#edition-2026`,
          name: 'Festival Dängo 2026',
          url: site.url,
          description:
            'Edición 2026 de Festival Dängo: música, arte y cultura en Teotihuacán.',
          startDate: site.date,
          eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
          image: [`${site.url}/images/ui/noticias/Line_Up.webp`],
          location: {
            '@type': 'Place',
            name: site.venue,
            address: {
              '@type': 'PostalAddress',
              streetAddress: 'Puerta 3, Rancho La Ventilla',
              addressLocality: 'Teotihuacán',
              addressRegion: 'Estado de México',
              addressCountry: 'MX',
            },
          },
          organizer: { '@id': `${site.url}/#organization` },
          performer: artists.map((artist) => ({
            '@type': 'PerformingGroup',
            name: artist.name,
          })),
        },
      ]
    : []),
];
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#11110f" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex
        ? 'noindex, follow'
        : 'index, follow, max-image-preview:large'}
    />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      as="font"
      href="/fonts/kismis-latin.woff2"
      type="font/woff2"
      crossorigin
    />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${site.url}/social-dango-2026.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Festival Dängo 2026 · Música, arte y cultura en Teotihuacán"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site.url}/social-dango-2026.jpg`} />
    {
      !noindex && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify({
            '@context': 'https://schema.org',
            '@graph': graph,
          }).replace(/</g, '\\u003c')}
        />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Navbar />
    <main id="contenido" tabindex="-1"><slot /></main>
    <Footer />
    <Motion />
  </body>
</html>
