---
import { site } from '../data/site';
import ResponsiveImage from './ResponsiveImage.astro';
---

<section
  id="ubicacion"
  class="location section-pad"
  aria-labelledby="location-title"
>
  <div class="shell location-grid">
    <div>
      <p class="eyebrow">03 / Nuestro punto de encuentro</p><h2
        id="location-title"
      >
        La música tiene<br /><span class="pink">un lugar sagrado.</span>
      </h2><p class="body-copy">
        Teotihuacán pone el paisaje. Dängo, el ritmo. Un encuentro entre música,
        arte y raíces en Rancho La Ventilla.
      </p><address>
        <strong>Rancho La Ventilla</strong><span>Puerta 3 · Teotihuacán</span
        ><span>Estado de México, México</span>
      </address><a
        class="button button-outline"
        href={site.maps}
        target="_blank"
        rel="noopener noreferrer"
        >Abrir en Google Maps <span aria-hidden="true">↗</span></a>
    </div>
    <figure class="venue-photo">
      <ResponsiveImage
        src="/images/ui/Fondo.webp"
        alt="Escenario al aire libre de Dängo al atardecer"
      /><figcaption>
        <span>RANCHO LA VENTILLA</span><span>TEOTIHUACÁN, MX</span>
      </figcaption>
    </figure>
  </div>
</section>
