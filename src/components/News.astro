---
import { site } from '../data/site';
import ResponsiveImage from './ResponsiveImage.astro';
const posts = [
  {
    image: 'Line_Up.webp',
    href: 'https://www.instagram.com/p/DRctIzliHba/',
    label: 'El cartel de Dängo 2026',
  },
  {
    image: 'Artista.webp',
    href: 'https://www.instagram.com/p/DSbBXTNjaZT/',
    label: 'Los artistas del festival',
  },
  {
    image: 'Dango.webp',
    href: 'https://www.instagram.com/p/DR8JnKtDOi6/',
    label: 'El universo Dängo',
  },
];
---

<section id="noticias" class="news section-pad" aria-labelledby="news-title">
  <div class="shell">
    <div class="section-heading">
      <div>
        <p class="eyebrow">04 / La comunidad sigue aquí</p><h2 id="news-title">
          El ritual<br /><span class="pink">no se termina.</span>
        </h2>
      </div><a
        class="text-link"
        href={site.instagram}
        target="_blank"
        rel="noopener noreferrer"
        >@festivaldango <span aria-hidden="true">↗</span></a>
    </div>
    <div class="news-grid">
      {
        posts.map((post) => (
          <a
            class="news-card"
            href={post.href}
            target="_blank"
            rel="noopener noreferrer"
          >
            <>
              <div class="news-image">
                <ResponsiveImage
                  src={`/images/ui/noticias/${post.image}`}
                  alt=""
                  sizes="(min-width: 700px) 31vw, 90vw"
                />
              </div>
              <div class="news-caption">
                <>
                  <h3>{post.label}</h3>
                  <span aria-hidden="true">↗</span>
                </>
              </div>
            </>
          </a>
        ))
      }
    </div>
  </div>
</section>
