---
import faq from '../data/faq.json';
import { site } from '../data/site';
const ids = ['ubicacion', 'boletos', 'horarios', 'servicios'];
---

<section class="info-page section-pad">
  <div class="shell">
    <p class="eyebrow">Dängo / Información</p><h1>
      Todo lo que<br /><span class="pink">necesitas saber.</span>
    </h1><p class="body-copy">
      Información publicada para la edición del <time datetime={site.date}
        >14 de febrero de 2026</time
      >. Esta edición ya concluyó; las condiciones de próximos eventos se
      anunciarán en los canales oficiales.
    </p>
    <div class="info-layout">
      <nav class="faq-nav" aria-label="Categorías de información">
        {
          faq.map((category, i) => (
            <a href={`#${ids[i]}`}>{category.category}</a>
          ))
        }<a href={`mailto:${site.email}`}>¿Otra duda? Escríbenos ↗</a>
      </nav><div class="faq-content">
        {
          faq.map((category, i) => (
            <section
              id={ids[i]}
              class="faq-group"
              aria-labelledby={`heading-${ids[i]}`}
            >
              <h2 id={`heading-${ids[i]}`}>{category.category}</h2>
              {category.items.map((item) => (
                <details class="faq-item">
                  <summary>
                    {item.question}
                    <span aria-hidden="true">＋</span>
                  </summary>
                  <div class="faq-answer" set:html={item.answer} />
                </details>
              ))}
            </section>
          ))
        }
      </div>
    </div>
  </div>
</section>
