---
import { artists } from '../data/site';
import media from '../data/media.json';
import IconSlider from './IconSlider.astro';
---

<section id="lineup" class="lineup section-pad" aria-labelledby="lineup-title">
  <div class="shell">
    <div class="section-heading">
      <div>
        <p class="eyebrow">01 / El sonido de Dängo</p><h2 id="lineup-title">
          Un cartel.<br /><span class="pink">Muchas formas de sentir.</span>
        </h2>
      </div><span class="edition-stamp">LINE UP<br /><strong>2026</strong></span
      >
    </div>
    <IconSlider direction="right" />
    <div class="artist-poster">
      <div class="artist-sunburst" aria-hidden="true"></div>
      <div class="artist-backdrop" aria-hidden="true"></div>
      <div class="heart-cloud" aria-hidden="true"></div>
      <div class="artist-list">
        {
          [1, 2, 3].map((tier) => (
            <div class:list={['artist-tier', `tier-${tier}`]}>
              {artists
                .filter((a) => a.tier === tier)
                .map((artist) => (
                  <a
                    href={`https://www.instagram.com/${artist.handle}/`}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-image={
                      media[
                        `/images/artistas/${artist.image}` as keyof typeof media
                      ]?.src
                    }
                  >
                    {artist.name}
                  </a>
                ))}
            </div>
          ))
        }
      </div>
      <button
        class="ritual-heart"
        type="button"
        aria-label="Siente el ritual: lanzar corazones"
        hidden
      >
        <span aria-hidden="true">♥</span> Siente el ritual
      </button>
      <p class="poster-note">
        Rock, indie y sonidos urbanos. Una misma energía.
      </p>
    </div>
    <IconSlider />
  </div>
</section>
<script>
  import '../scripts/lineup';
</script>
