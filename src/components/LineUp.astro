---
import { artists } from '../data/site';
import media from '../data/media.json';
---

<section id="lineup" class="lineup section-pad" aria-labelledby="lineup-title">
  <div class="shell">
    <div class="section-heading">
      <div>
        <p class="eyebrow">01 / El sonido de Dängo</p><h2 id="lineup-title">
          Un cartel.<br /><span class="pink">Muchas formas de sentir.</span>
        </h2>
      </div><span class="edition-stamp"
        >LINE UP<br /><strong>2026</strong></span>
    </div>
    <div class="artist-poster">
      <div class="artist-backdrop" aria-hidden="true"></div>
      <div class="artist-list">
        {
          [1, 2, 3].map((tier) => (
            <div class:list={['artist-tier', `tier-${tier}`]}>
              {artists
                .filter((a) => a.tier === tier)
                .map((artist) => (
                  <a
                    href={`https://www.instagram.com/${artist.handle}/`}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-image={
                      media[
                        `/images/artistas/${artist.image}` as keyof typeof media
                      ]?.full
                    }
                  >
                    {artist.name}
                  </a>
                ))}
            </div>
          ))
        }
      </div>
      <p class="poster-note">
        Rock, indie y sonidos urbanos. Una misma energía.
      </p>
    </div>
  </div>
</section>
<script>
  const backdrop = document.querySelector<HTMLElement>('.artist-backdrop');
  const hover = matchMedia(
    '(hover: hover) and (prefers-reduced-motion: no-preference)',
  );
  document
    .querySelectorAll<HTMLAnchorElement>('.artist-list a')
    .forEach((link) => {
      const show = () => {
        if (!backdrop || !hover.matches || !link.dataset.image) return;
        backdrop.style.backgroundImage = `url("${link.dataset.image}")`;
        backdrop.classList.add('visible');
      };
      const hide = () => backdrop?.classList.remove('visible');
      link.addEventListener('mouseenter', show);
      link.addEventListener('mouseleave', hide);
      link.addEventListener('focus', show);
      link.addEventListener('blur', hide);
    });
</script>
