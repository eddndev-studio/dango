---
import media from '../data/media.json';
import captions from '../data/gallery-captions.json';
import ResponsiveImage from './ResponsiveImage.astro';
interface Props {
  folder: string;
  title: string;
  id: string;
  subtitle: string;
  number?: string;
}
const { folder, title, id, subtitle, number = '02' } = Astro.props;
const images = Object.keys(media)
  .filter((src) => src.startsWith(`/images/Galerias/${folder}/`))
  .sort((a, b) => a.localeCompare(b, 'es', { numeric: true }));
const previewCount = 6;
const entries = images.map((src, i) => ({
  ...media[src as keyof typeof media],
  src,
  index: i,
  alt: captions[src.replace('/images/Galerias/', '') as keyof typeof captions],
}));
---

<section id={id} class="gallery section-pad" aria-labelledby={`${id}-title`}>
  <div class="shell">
    <div class="section-heading">
      <div>
        <p class="eyebrow">{number} / Memorias del festival</p><h2
          id={`${id}-title`}
        >
          {title}<span class="pink">.</span>
        </h2><p class="body-copy">{subtitle}</p>
      </div><span class="photo-count"
        >{images.length} fotografías<br /><span>Archivo Dängo</span></span
      >
    </div>
    <div class="photo-grid">
      {
        entries.slice(0, previewCount).map((item) => (
          <a
            class="photo"
            href={item.full}
            data-gallery-image
            data-index={item.index}
            aria-label={`Ampliar: ${item.alt}`}
          >
            <>
              <ResponsiveImage
                src={item.src}
                alt={item.alt}
                sizes="(min-width: 900px) 32vw, 46vw"
              />
              <span class="photo-expand" aria-hidden="true">
                ↗
              </span>
            </>
          </a>
        ))
      }
    </div>
    {
      entries.length > previewCount && (
        <details class="more-photos">
          <>
            <summary class="button button-outline">
              <>
                <span class="when-closed">
                  Ver las {images.length} fotografías
                </span>
                <span class="when-open">Mostrar menos fotografías</span>
                <span aria-hidden="true">＋</span>
              </>
            </summary>
            <div class="photo-grid">
              {entries.slice(previewCount).map((item) => (
                <a
                  class="photo"
                  href={item.full}
                  data-gallery-image
                  data-index={item.index}
                  aria-label={`Ampliar: ${item.alt}`}
                >
                  <ResponsiveImage
                    src={item.src}
                    alt={item.alt}
                    sizes="(min-width: 900px) 32vw, 46vw"
                  />
                  <span class="photo-expand" aria-hidden="true">
                    ↗
                  </span>
                </a>
              ))}
            </div>
          </>
        </details>
      )
    }
  </div>
  <dialog class="lightbox" aria-label={`Galería ${title}`} data-lenis-prevent>
    <div class="lightbox-top">
      <p class="lightbox-counter" role="status" aria-live="polite"></p><button
        class="icon-button"
        type="button"
        aria-label="Cerrar fotografía"
        data-gallery-close>×</button
      >
    </div>
    <div class="lightbox-stage">
      <button
        type="button"
        class="icon-button"
        aria-label="Fotografía anterior"
        data-gallery-prev>←</button
      ><figure>
        <img class="lightbox-image" alt="" draggable="false" /><figcaption>
        </figcaption>
      </figure><button
        type="button"
        class="icon-button"
        aria-label="Fotografía siguiente"
        data-gallery-next>→</button
      >
    </div>
  </dialog>
</section>
<script>
  import { motionState } from '../scripts/motion';
  document.querySelectorAll<HTMLElement>('.gallery').forEach((section) => {
    const dialog = section.querySelector<HTMLDialogElement>('dialog');
    const image = section.querySelector<HTMLImageElement>('.lightbox-image');
    const caption = section.querySelector('figcaption');
    const counter = section.querySelector('.lightbox-counter');
    const links = Array.from(
      section.querySelectorAll<HTMLAnchorElement>('[data-gallery-image]'),
    );
    let current = 0;
    let trigger: HTMLAnchorElement | undefined;
    let transition: Animation | undefined;
    if (!dialog || !image) return;
    const show = (index: number) => {
      const direction = index < current ? -1 : 1;
      transition?.cancel();
      current = (index + links.length) % links.length;
      const link = links[current];
      image.src = link.href;
      image.alt = link.querySelector('img')?.alt ?? '';
      if (caption) caption.textContent = image.alt;
      if (counter) counter.textContent = `${current + 1} / ${links.length}`;
      if (motionState().enabled && dialog.open) {
        transition = image.animate(
          [
            { opacity: 0.35, transform: `translateX(${direction * 28}px)` },
            { opacity: 1, transform: 'translateX(0)' },
          ],
          { duration: 240, easing: 'ease-out' },
        );
      }
    };
    // Leave vertical scrolling and pinch zoom native; recognize horizontal swipes only.
    let touch: { id: number; x: number; y: number } | undefined;
    image.addEventListener('pointerdown', (event) => {
      if (!event.isPrimary || event.button !== 0) {
        touch = undefined;
        return;
      }
      touch = { id: event.pointerId, x: event.clientX, y: event.clientY };
      image.setPointerCapture(event.pointerId);
    });
    image.addEventListener('pointerup', (event) => {
      if (touch && event.pointerId === touch.id) {
        const dx = event.clientX - touch.x,
          dy = event.clientY - touch.y;
        if (Math.abs(dx) > 55 && Math.abs(dx) > Math.abs(dy) * 1.5)
          show(current + (dx < 0 ? 1 : -1));
      }
      touch = undefined;
    });
    image.addEventListener('pointercancel', () => {
      touch = undefined;
    });
    image.addEventListener('lostpointercapture', () => {
      touch = undefined;
    });
    links.forEach((link, index) =>
      link.addEventListener('click', (event) => {
        if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey)
          return;
        event.preventDefault();
        trigger = link;
        show(index);
        dialog.showModal();
        document.documentElement.classList.add('modal-open');
      }),
    );
    section
      .querySelector('[data-gallery-close]')
      ?.addEventListener('click', () => dialog.close());
    section
      .querySelector('[data-gallery-prev]')
      ?.addEventListener('click', () => show(current - 1));
    section
      .querySelector('[data-gallery-next]')
      ?.addEventListener('click', () => show(current + 1));
    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        show(current + 1);
      }
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        show(current - 1);
      }
    });
    dialog.addEventListener('click', (event) => {
      if (
        event.target === dialog ||
        event.target === section.querySelector('.lightbox-stage')
      )
        dialog.close();
    });
    dialog.addEventListener('close', () => {
      transition?.cancel();
      touch = undefined;
      document.documentElement.classList.remove('modal-open');
      image.removeAttribute('src');
      trigger?.focus({ preventScroll: true });
    });
  });
</script>
