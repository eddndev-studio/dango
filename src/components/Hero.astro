---
import DangoLogo from './DangoLogo.astro';
import ResponsiveImage from './ResponsiveImage.astro';
import { site } from '../data/site';
---

<section class="hero" aria-labelledby="hero-title">
  <ResponsiveImage
    src="/images/ui/Fondo.webp"
    alt=""
    class="hero-background"
    sizes="100vw"
    priority
  />
  <div class="hero-shade"></div>
  <div class="shell hero-content">
    <div class="hero-top">
      <span>TEOTIHUACÁN, MÉXICO</span><span
        >EDICIÓN 2026 <span aria-hidden="true">✳</span>
        <time datetime={site.date}>14 FEB</time></span>
    </div>
    <div class="hero-center">
      <h1 id="hero-title">
        <span class="sr-only"
          >Festival Dängo 2026: música, arte y cultura en Teotihuacán</span
        ><DangoLogo class="hero-logo" />
      </h1><p class="hero-manifesto">Música. Raíces. Comunidad.</p>
    </div>
    <div class="hero-bottom">
      <p>Donde el sonido ancestral<br />encuentra el ritmo del futuro.</p><div
        class="hero-actions"
      >
        <a class="button button-pink" href="#lineup"
          >Explora el festival <span aria-hidden="true">↘</span></a
        ><a class="button button-glass" href="#galeria-dango"
          >Ver galería <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </div>
</section>
