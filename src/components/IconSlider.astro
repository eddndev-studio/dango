---
// Static decorative strip: no animation loop, repeated DOM, or layout measurements.
---

<div class="icon-strip" aria-hidden="true">
  {
    Array.from({ length: 18 }, (_, i) => (
      <img
        src={`/icons/M${i + 1}.svg`}
        alt=""
        width="72"
        height="48"
        loading="lazy"
        decoding="async"
      />
    ))
  }
</div>
