---
import DangoLogo from './DangoLogo.astro';
import { navigation, site } from '../data/site';
---

<header class="site-header">
  <div class="shell header-inner">
    <a href="/" class="brand" aria-label="Festival Dängo, inicio"
      ><DangoLogo /></a
    >
    <nav class="desktop-nav" aria-label="Navegación principal">
      {
        navigation.map((item) => (
          <a
            href={item.href}
            aria-current={Astro.url.pathname === item.href ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <a
      class="header-cta"
      href={site.instagram}
      target="_blank"
      rel="noopener noreferrer"
      >Sigue el ritual <span aria-hidden="true">↗</span></a
    >
    <button
      class="menu-toggle"
      type="button"
      aria-label="Abrir menú"
      aria-controls="mobile-menu"
      aria-expanded="false"
      hidden><span>Menú</span><span aria-hidden="true">☰</span></button
    >
  </div>
  <noscript
    ><nav class="noscript-nav" aria-label="Navegación móvil">
      {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav></noscript
  >
</header>
<dialog
  id="mobile-menu"
  class="menu-dialog"
  aria-label="Menú principal"
  data-lenis-prevent
>
  <div class="menu-top">
    <span class="eyebrow">Dängo · Teotihuacán</span><button
      type="button"
      class="icon-button"
      aria-label="Cerrar menú"
      data-close-menu>×</button
    >
  </div>
  <nav aria-label="Navegación móvil">
    {
      navigation.map((item, i) => (
        <a href={item.href}>
          <span class="menu-number">0{i + 1}</span>
          {item.label}
          <span aria-hidden="true">↗</span>
        </a>
      ))
    }
  </nav>
  <p class="menu-bottom">Música. Raíces. Comunidad.</p>
</dialog>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.querySelector<HTMLDialogElement>('#mobile-menu');
  if (toggle && menu) {
    let navigating = false;
    toggle.hidden = false;
    toggle.addEventListener('click', () => {
      navigating = false;
      menu.showModal();
      document.documentElement.classList.add('modal-open');
      toggle.setAttribute('aria-expanded', 'true');
    });
    menu
      .querySelector('[data-close-menu]')
      ?.addEventListener('click', () => menu.close());
    menu.querySelectorAll('a').forEach((link) =>
      link.addEventListener('click', () => {
        navigating = true;
        document.documentElement.classList.remove('modal-open');
        menu.close();
      }),
    );
    menu.addEventListener('click', (event) => {
      if (event.target === menu) menu.close();
    });
    menu.addEventListener('close', () => {
      document.documentElement.classList.remove('modal-open');
      toggle.setAttribute('aria-expanded', 'false');
      if (!navigating) toggle.focus({ preventScroll: true });
    });
    matchMedia('(min-width: 960px)').addEventListener('change', (event) => {
      if (event.matches && menu.open) menu.close();
    });
  }
</script>
