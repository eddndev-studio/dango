---
import { site } from '../data/site';
---

<section id="boletos" class="edition-info" aria-label="Edición 2026 y boletos">
  <div class="shell edition-info-inner">
    <div>
      <span class="eyebrow">Edición 2026 · Archivo</span><p>
        El encuentro pasa.<br /><strong>La energía se queda.</strong>
      </p>
    </div><div class="edition-details">
      <p>
        <time datetime={site.date}>{site.dateLabel}</time><br />Rancho La
        Ventilla · Teotihuacán
      </p><p class="muted">
        Esta edición ya concluyó. Sigue nuestros canales oficiales para conocer
        los próximos anuncios.
      </p><div class="edition-links">
        <a href={site.instagram} target="_blank" rel="noopener noreferrer"
          >Novedades en Instagram ↗</a
        ><a href="/informacion/#boletos">Información de boletos ↗</a>
      </div>
    </div>
  </div>
</section>
