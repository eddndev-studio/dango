---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Tickets from '../components/Tickets.astro';
import LineUp from '../components/LineUp.astro';
import Gallery from '../components/Gallery.astro';
import Location from '../components/Location.astro';
import News from '../components/News.astro';
import IconSlider from '../components/IconSlider.astro';
---

<Layout title="Festival Dängo 2026 | Música y cultura en Teotihuacán">
  <Hero />
  <IconSlider />
  <Tickets />
  <LineUp />
  <Gallery
    folder="Dango"
    title="Así se siente Dängo"
    id="galeria-dango"
    subtitle="Luces, encuentros y momentos que se quedan. Explora nuestro archivo fotográfico."
  />
  <Gallery
    folder="Ritual_Dango"
    title="Ritual Dängo"
    id="galeria-ritual"
    subtitle="Otra mirada a la comunidad y la energía que dan vida al festival."
  />
  <Location />
  <IconSlider />
  <News />
</Layout>
